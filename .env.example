# ===== FRONTEND (public — safe to expose, goes into the browser bundle) =====
# Leave empty if the API lives on the same domain (Vercel). Only set when the API is hosted elsewhere.
VITE_API_BASE=
# Your bot's username WITHOUT @ — used by the "Do‘stlarga ulashish" button
VITE_BOT_USERNAME=

# ===== SERVER ONLY (set these in Vercel -> Settings -> Environment Variables; NEVER prefix with VITE_) =====
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Public https URL of the deployed app, e.g. https://smartlingo.vercel.app
WEBAPP_URL=
# Random secret string you invent; protects the bot webhook endpoint
WEBHOOK_SECRET=
# Optional: enables the live AI tutor "Lingo". Without it the tutor runs in DEMO mode.
ANTHROPIC_API_KEY=
# Optional: model id for the tutor (default claude-haiku-5-5)
AI_MODEL=

# ===== ONLINE FEATURES (rating, leaderboard, live duels, progress backup, AI limits) =====
# Supabase project URL and the SERVICE-ROLE key (Project Settings -> API). Server only, never VITE_.
# The rating lives in the `ratings` table (supabase/schema.sql) and only these server functions write it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Free key from console.groq.com — powers writing check, "Nega xato?", generated texts, tutor, roadmap.
GROQ_API_KEY=
# Optional (default openai/gpt-oss-20b)
GROQ_MODEL=
# PRIVACY: in console.groq.com -> Settings -> Data Controls turn ON "Zero Data Retention".
# The app itself stores no chat text, no essays and writes no server logs.
